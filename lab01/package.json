{
  "name": "lab01-experimentacao-software",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Coleta e caracterização dos 1.000 repositórios mais populares do GitHub (Lab01 - Laboratório de Experimentação de Software)",
  "scripts": {
    "collect": "node --env-file=.env --import tsx src/collect.ts",
    "snapshot": "node --env-file=.env --import tsx src/snapshot.ts",
    "validate:rq08": "node --env-file=.env --import tsx scripts/validate-rq08.ts",
    "validate:rq09-rq11": "node --env-file=.env --import tsx scripts/validate-rq09-rq11.ts",
    "validate:rq05-rq06": "node --env-file=.env --import tsx scripts/validate-rq05-rq06.ts",
    "validate:rq01-rq02": "node --env-file=.env --import tsx scripts/validate-rq01-rq02.ts",
    "data-quality": "tsx scripts/data-quality.ts",
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
